rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function isMember() { return signedIn() && exists(userDoc()); }
    function isAdmin() { return isMember() && get(userDoc()).data.rol == 'admin'; }

    // Marca que ya existe un administrador (la app la lee antes del login)
    match /config/admin {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/config/admin)
        && request.resource.data.uid == request.auth.uid
        && getAfter(userDoc()).data.rol == 'admin';
    }

    match /usuarios/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      // El primer administrador se crea solo si todavía no hay ninguno
      allow create: if isAdmin()
        || (signedIn() && uid == request.auth.uid
            && request.resource.data.rol == 'admin'
            && !exists(/databases/$(database)/documents/config/admin)
            && existsAfter(/databases/$(database)/documents/config/admin));
      allow update, delete: if isAdmin();
    }

    match /productos/{id} { allow read: if isMember(); allow write: if isAdmin(); }
    match /compras/{id}   { allow read: if isMember(); allow write: if isAdmin(); }
    match /clientes/{id}  { allow read, create: if isMember(); allow update, delete: if isAdmin(); }

    // Catálogo online: lo lee cualquiera con el link, solo el administrador lo escribe
    match /catalogo/{id} { allow read: if true; allow write: if isAdmin(); }

    // Visitas al catálogo: cualquiera puede sumar de a 1, solo el administrador lee
    function incOk(k) {
      let old = resource == null ? 0 : resource.data.get(k, 0);
      let nw = request.resource.data.get(k, 0);
      return nw is int && (nw == old || nw == old + 1);
    }
    match /stats/{dia} {
      allow read: if isAdmin();
      allow create, update: if dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['visitas','nuevos','pedidos'])
        && incOk('visitas') && incOk('nuevos') && incOk('pedidos');
      allow delete: if false;
    }


    // Sorteo del catálogo: cualquiera se anota (solo crear); solo el administrador lee, edita o borra
    match /sorteo/{id} {
      allow create: if id.matches('[a-z0-9]{8,20}')
        && request.resource.data.keys().hasAll(['nombre','tel','dev','creado'])
        && request.resource.data.keys().hasOnly(['nombre','tel','dev','creado','ref'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 40
        && request.resource.data.tel is string && request.resource.data.tel.size() >= 8 && request.resource.data.tel.size() <= 20
        && request.resource.data.dev is string && request.resource.data.dev.size() <= 40
        && request.resource.data.creado is int
        && (!('ref' in request.resource.data) || (request.resource.data.ref is string && request.resource.data.ref.size() <= 20));
      allow read, update, delete: if isAdmin();
      // Una visita por celular a cada link (no se puede editar ni repetir)
      match /visitas/{dev} {
        allow create: if dev.matches('[a-z0-9]{12,40}')
          && exists(/databases/$(database)/documents/sorteo/$(id))
          && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t is int;
        allow read, delete: if isAdmin();
      }
    }
    match /{path=**}/visitas/{dev} { allow read: if isAdmin(); }

    match /ventas/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.vendedor == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isMember() && resource.data.vendedor == request.auth.uid);
    }
  }
}
